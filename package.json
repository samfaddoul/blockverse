{
  "name": "blockverse",
  "version": "1.0.0",
  "private": true,
  "description": "Blockverse - a blocky 3D sandbox adventure built with Three.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --sourcemap --format=iife --target=es2020 --outfile=dist/game.js",
    "dev": "esbuild src/main.js --bundle --sourcemap --format=iife --target=es2020 --outfile=dist/game.js --servedir=. --watch",
    "start": "npm run build && esbuild --servedir=. --serve=5173"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "puppeteer-core": "23.6.0"
  }
}
